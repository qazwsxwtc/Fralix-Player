                    width="10" 
                    height="100"
                    min="0" max="200" value="100" hor="false" tooltip="调节音量" thumbsize="10,10"
bkimage="file='bgv.bmp' corner='0,0,0,0' mask='#FFFF00FF'"
foreimage="file='fgv.bmp' corner='0,0,0,0' mask='#FFFF00FF'"
thumbimage="file='thumbv.bmp' source='0,0,10,10' mask='#FFDAEBF9' corner='0,0,0,0'"
thumbhotimage="file='thumbv.bmp' source='0,10,10,20' mask='#FFDAEBF9' corner='0,0,0,0'"
thumbpushedimage="file='thumbv.bmp' source='0,20,10,30' corner='0,0,0,0'"  />
        </VerticalLayout>

    </VerticalLayout>
</Window>