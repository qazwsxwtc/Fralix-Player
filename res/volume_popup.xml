    <VerticalLayout bkcolor="#FF2D2D2D" bordersize="0" bordercolor="#FF444444" > 
        <!-- 中间：垂直滑动条 -->
        <VerticalLayout >
            <!-- 使用 vertical="true" 实现垂直滑动 -->
